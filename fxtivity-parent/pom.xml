<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ctgnz</groupId>
    <artifactId>fxtivity-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>fxtivity Parent</name>
    <description>Shared build configuration for every fxtivity module: the Java level, the encoding, the dependency versions, the formatter and import order, and the release profile.</description>
    <url>https://github.com/ctgnz/fxtivity</url>

    <!--
        Every module's build configuration, and nothing else: it carries no modules, so it is
        published with the libraries - a consumer resolving fxtivity-core reads it as that module's
        parent - while the root pom only lists what is in the repository. The same split as
        jmsfx-parent (jmsfx#102).
    -->

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Colin Sharples</name>
            <email>ctg@ctg.co.nz</email>
            <organization>CTG Games Limited</organization>
            <organizationUrl>https://www.ctg.co.nz</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/ctgnz/fxtivity.git</connection>
        <developerConnection>scm:git:ssh://github.com/ctgnz/fxtivity.git</developerConnection>
        <url>http://github.com/ctgnz/fxtivity/tree/master</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <javafx.version>25.0.3</javafx.version>
        <jackson.version>2.22.2</jackson.version>
        <cucumber.version>7.34.8</cucumber.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                The BOM rather than a single version property, because jackson-annotations stopped
                tracking the patch version of the other Jackson modules at 2.20 and is versioned on its
                own line now. The BOM knows which annotations release goes with databind 2.22.2.
            -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ctgnz</groupId>
                <artifactId>yaml-flock</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-java</artifactId>
                <version>${cucumber.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-junit-platform-engine</artifactId>
                <version>${cucumber.version}</version>
            </dependency>
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest</artifactId>
                <version>2.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <!-- The previous default predates the JUnit Platform entirely and cannot discover Jupiter/Cucumber tests. -->
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <!--
                    The config is found from the repository root, so builds - local and CI - run from
                    there, as jmsfx's do. Run from inside a module, the formatter files are not found.
                -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.44.5</version>
                <configuration>
                    <java>
                        <importOrder>
                            <file>${maven.multiModuleProjectDirectory}/config/eclipse.importorder</file>
                        </importOrder>
                        <removeUnusedImports/>
                        <eclipse>
                            <file>${maven.multiModuleProjectDirectory}/config/eclipse-formatter.xml</file>
                        </eclipse>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <!--
                                Keep doclint checking syntax, html and references, and drop only
                                "missing" - an unresolvable {@link} is a real error and javadoc is the
                                only thing that finds one.
                            -->
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!--
                            autoPublish false: a tag stages a validated deployment on the Portal and
                            publishing stays a deliberate step, so a bad staging is dropped rather than
                            superseded.
                        -->
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <excludeArtifacts>
                                <!--
                                    The root aggregator: its only content is the module list, and no
                                    module inherits it, so nothing a consumer resolves needs it.
                                -->
                                <excludeArtifact>fxtivity</excludeArtifact>
                                <!-- The worked example and its application: documentation that runs, not a library. -->
                                <excludeArtifact>fxtivity-example</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
